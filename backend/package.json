{
  "name": "safebox-backend",
  "version": "1.0.0",
  "description": "SafeBox Backend - Zero-knowledge password manager API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "tsx watch src/index.ts",
    "dev:ai": "tsx watch src/ai/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:api": "node dist/index.js",
    "start:ai": "node dist/ai/worker.js",
    "test": "jest",
    "test:security": "jest --runInBand src/security",
    "test:watch": "jest --watch",
    "test:audit": "tsx src/ai/agents/__tests__/test-audit-agent.ts",
    "jobs:maintenance": "tsx src/jobs/maintenance.ts --dry-run",
    "test:supabase": "tsx src/scripts/test-supabase.ts",
    "health-check": "tsx src/scripts/health-check.ts",
    "db:setup": "echo 'Execute o SQL do arquivo database-optimized.sql no Supabase SQL Editor'",
    "generate:jwt": "tsx src/scripts/generate-jwt-secret.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit -p tsconfig.security.json",
    "type-check:full": "tsc --noEmit",
    "db:generate": "supabase gen types typescript --local > src/types/database.ts",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "edge-functions:serve": "supabase functions serve",
    "edge-functions:deploy": "supabase functions deploy"
  },
  "keywords": [
    "password-manager",
    "zero-knowledge",
    "encryption",
    "security",
    "supabase"
  ],
  "author": "SafeBox Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "~2.49.8",
    "axios": "^1.12.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-slow-down": "^2.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.5",
    "rate-limiter-flexible": "^4.0.1",
    "redis": "^5.12.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.17",
    "@types/nodemailer": "^7.0.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "supabase": "^2.92.1",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.58.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
