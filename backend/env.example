# ===========================================
# SAFEBOX BACKEND - ENVIRONMENT VARIABLES
# ===========================================

# Database (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Redis (Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret (gerar com: node src/scripts/generate-jwt-secret.ts)
JWT_SECRET=your-jwt-secret-here-minimum-32-characters
JWT_EXPIRES_IN=7d
TWO_FACTOR_ENCRYPTION_SECRET=your-two-factor-encryption-secret-32-chars-min

# Server
PORT=3001
NODE_ENV=development

# ===========================================
# AI / LLM CONFIGURATION (LM Studio)
# ===========================================

# LM Studio Host (API OpenAI-compatible)
LMSTUDIO_HOST=http://localhost:1234

# Modelo carregado no LM Studio
LMSTUDIO_MODEL=gpt-oss-20b

# Timeout para requisições LLM (ms)
LLM_TIMEOUT=120000

# Máximo de tentativas em caso de falha
LLM_MAX_RETRIES=3

# ===========================================
# EMAIL NOTIFICATIONS
# ===========================================

# Gmail Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_FROM=SafeBox AI <your-email@gmail.com>

# Destinatários padrão para relatórios
EMAIL_REPORT_TO=admin@yourcompany.com

# ===========================================
# REPORTS
# ===========================================

# Diretório para salvar relatórios
REPORTS_DIR=./reports

# Formato dos relatórios (comma-separated: markdown,html,json,pdf)
REPORT_FORMATS=markdown,html,json,pdf

# ===========================================
# AI AGENTS CONFIGURATION
# ===========================================

# Automation Level (ALERTS_ONLY, SUGGEST_ACTIONS, PARTIAL_AUTOMATION, FULL_AUTOMATION)
AI_AUTOMATION_LEVEL=PARTIAL_AUTOMATION

# Agendamento semanal (cron format - Domingo 02:00)
AI_SCHEDULE=0 2 * * 0

# Timeout geral para agentes (segundos)
AI_AGENT_TIMEOUT=300

# Máximo de retries
AI_AGENT_MAX_RETRIES=3

# ===========================================
# COMPLIANCE
# ===========================================

# Compliance frameworks habilitados (comma-separated)
COMPLIANCE_FRAMEWORKS=LGPD,GDPR,ISO27001,SOC2

# Prioridade de compliance (LOW, MEDIUM, HIGH)
COMPLIANCE_PRIORITY=MEDIUM

# ===========================================
# SECURITY
# ===========================================

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Helmet security headers
HELMET_ENABLED=true

# ===========================================
# LOGGING
# ===========================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log file path
LOG_FILE=./logs/app.log
AUDIT_LOG_FILE=./logs/audit.log
