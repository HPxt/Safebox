{
  "name": "safebox-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix backend run dev:api",
    "dev:backend": "npm --prefix backend run dev:api",
    "dev:ai": "npm --prefix backend run dev:ai",
    "dev:frontend": "npm --prefix frontend start",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm --prefix frontend test -- --watchAll=false",
    "test:backend": "npm --prefix backend test -- --runInBand",
    "test:appsec": "npm --prefix backend run test:appsec",
    "test:appsec:static": "node scripts/appsec-static-checks.js",
    "audit:backend": "npm --prefix backend audit",
    "audit:frontend": "npm --prefix frontend audit",
    "audit:frontend:prod": "npm --prefix frontend run audit:prod",
    "lint:backend": "npm --prefix backend run lint",
    "typecheck:backend": "npm --prefix backend run type-check",
    "ios:static-gate": "node scripts/ios-static-gate.mjs",
    "quality:gate": "npm run test && npm run build && npm run lint:backend && npm run typecheck:backend"
  },
  "packageManager": "npm@10.9.2"
}
